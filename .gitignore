# Python bytecode, environments and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.venv-*/
venv/
.env

# Training and analysis outputs (inspect before committing anything derived)
models/runs/
models/**/runs/
runs/
outputs/
logs/
*.h5
*.hdf5
*.keras
*.ckpt
*.ckpt.*
*.bak

# Published anonymized data remain versioned; ignore other local datasets
# by default. These rules do not remove existing tracked files.
data/*
!data/README.md
!data/X.csv
!data/Y.csv
